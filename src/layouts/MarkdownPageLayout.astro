---
import type { ImageMetadata } from 'astro';

import SiteLayout from './SiteLayout.astro';
import { type Locale } from '../lib/i18n';
import { localeMetadata } from '../lib/site';

interface Frontmatter {
  locale: Locale;
  title: string;
  description?: string;
  subtitle?: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const { frontmatter } = Astro.props;
const {
  locale,
  title,
  description,
  subtitle,
  socialImage: socialImagePath,
  socialImageAlt,
} = frontmatter as Frontmatter;
const images = import.meta.glob<ImageMetadata>('../assets/images/**/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
  import: 'default',
});
const socialImage = socialImagePath?.startsWith('~/assets/')
  ? images[socialImagePath.replace('~/', '../')]?.src
  : socialImagePath;
---

<SiteLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={Astro.url.pathname}
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
>
  <article class="content-body mx-auto w-full max-w-3xl">
    <header class="mb-10 space-y-4 border-b border-(--border-muted) pb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-(--color-primary)">
        {localeMetadata[locale].pageLabel}
      </p>
      <h1 class="font-heading text-4xl leading-tight text-(--color-heading) sm:text-5xl">
        {title}
      </h1>
      {subtitle && <p class="text-lg leading-8 text-(--color-muted)">{subtitle}</p>}
    </header>
    <slot />
  </article>
</SiteLayout>
