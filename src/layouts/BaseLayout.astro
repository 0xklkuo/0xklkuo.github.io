---
import '../styles/global.css';

import Analytics from '../components/site/Analytics.astro';
import {
  getLocaleFromPathname,
  getLocalizedPath,
  localizePathname,
  stripLocaleFromPathname,
  type Locale,
} from '../lib/i18n';
import { localeMetadata, site } from '../lib/site';

type AlternateLinks = Partial<Record<Locale, string>>;

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalPath?: string;
  author?: string;
  openGraphType?: 'website' | 'article';
  socialImage?: string;
  socialImageAlt?: string;
  keywords?: string[];
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  alternateLinks?: AlternateLinks | null;
}

const {
  locale,
  title,
  description = site.description,
  canonicalPath = getLocalizedPath(locale),
  author = site.name,
  openGraphType = 'website',
  socialImage,
  socialImageAlt = title ?? site.name,
  keywords = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  alternateLinks,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(canonicalPath, site.url).toString();
const basePath = stripLocaleFromPathname(canonicalPath);
const hasLocalizedAlternates = getLocaleFromPathname(canonicalPath) !== null;
const defaultAlternates = hasLocalizedAlternates
  ? site.locales.reduce<AlternateLinks>((links, alternateLocale) => {
      links[alternateLocale] = new URL(
        localizePathname(basePath, alternateLocale),
        site.url,
      ).toString();
      return links;
    }, {})
  : null;
const alternateLinkInput = alternateLinks === undefined ? defaultAlternates : alternateLinks;
const resolvedAlternateLinks = alternateLinkInput
  ? site.locales.reduce<AlternateLinks>((links, alternateLocale) => {
      const href = alternateLinkInput[alternateLocale];

      if (href) {
        links[alternateLocale] = new URL(href, site.url).toString();
      }

      return links;
    }, {})
  : null;
const xDefaultHref = resolvedAlternateLinks?.[site.defaultLocale] ?? canonical;
const resolvedSocialImage = socialImage ? new URL(socialImage, site.url).toString() : undefined;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const keywordContent = keywords.filter(Boolean).join(', ');
---

<!doctype html>
<html lang={localeMetadata[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#f9f9f9" />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeMetadata[locale].ogLocale} />
    <meta name="twitter:card" content={resolvedSocialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {keywordContent && <meta name="keywords" content={keywordContent} />}
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <link rel="canonical" href={canonical} />
    {
      resolvedAlternateLinks && (
        <>
          {site.locales.map(
            (alternateLocale) =>
              resolvedAlternateLinks[alternateLocale] && (
                <link
                  rel="alternate"
                  hreflang={alternateLocale}
                  href={resolvedAlternateLinks[alternateLocale]}
                />
              ),
          )}
          <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        const getStoredTheme = () => window.localStorage.getItem(storageKey) ?? 'system';

        const syncThemeButtons = () => {
          const toggleButtons = document.querySelectorAll('[data-theme-toggle]');
          const isDark = root.classList.contains('dark');

          for (const button of toggleButtons) {
            const label = isDark
              ? (button.getAttribute('data-theme-label-dark') ?? 'Switch to light mode')
              : (button.getAttribute('data-theme-label-light') ?? 'Switch to dark mode');

            button.setAttribute('aria-label', label);
            button.setAttribute('title', label);
            button.setAttribute('aria-pressed', String(isDark));

            const srText = button.querySelector('[data-theme-toggle-text]');
            if (srText) {
              srText.textContent = label;
            }
          }
        };

        const applyTheme = (theme) => {
          const shouldUseDark = theme === 'dark' || (theme === 'system' && media.matches);

          root.classList.toggle('dark', shouldUseDark);
          root.dataset.theme = theme;
          syncThemeButtons();
        };

        const registerToggle = () => {
          const toggleButtons = document.querySelectorAll('[data-theme-toggle]');

          for (const button of toggleButtons) {
            button.addEventListener('click', () => {
              const nextTheme = root.classList.contains('dark') ? 'light' : 'dark';
              window.localStorage.setItem(storageKey, nextTheme);
              applyTheme(nextTheme);
            });
          }

          syncThemeButtons();
        };

        applyTheme(getStoredTheme());

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', registerToggle, {
            once: true,
          });
        } else {
          registerToggle();
        }

        media.addEventListener('change', () => applyTheme(getStoredTheme()));
      })();
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen bg-(--color-page) text-(--color-default) antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-6 py-8 sm:px-8 lg:px-10">
      <slot />
    </main>
  </body>
</html>
