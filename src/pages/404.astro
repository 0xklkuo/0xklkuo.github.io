---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout locale="en" title="Page not found" canonicalPath="/404/">
  <div class="mx-auto flex min-h-[50vh] w-full max-w-3xl flex-col justify-center gap-6">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-(--color-primary)">404</p>
    <h1 class="font-heading text-5xl leading-tight text-(--color-heading)">Page not found</h1>
    <p class="text-lg leading-8 text-(--color-default)">
      The route you requested does not exist in the rebuilt static site.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/en/"
        class="rounded-full border border-(--color-primary) px-4 py-2 no-underline transition hover:bg-(--color-primary)/10"
      >
        Go to /en/
      </a>
      <a
        href="/zh/"
        class="rounded-full border border-(--border-muted) px-4 py-2 no-underline transition hover:border-(--color-primary)"
      >
        前往 /zh/
      </a>
    </div>
  </div>
</SiteLayout>
