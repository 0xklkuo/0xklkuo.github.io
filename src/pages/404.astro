---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="en" title="Page not found" canonicalPath="/404/">
  <div class="flex min-h-[60vh] flex-col items-start justify-center gap-6">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-sky-600 dark:text-sky-300">
      404
    </p>
    <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="max-w-xl text-lg leading-8 text-slate-600 dark:text-slate-300">
      This foundation reset removed the old route structure. The new site shell will be rebuilt in
      the next milestones.
    </p>
    <a
      class="rounded-full border border-slate-300 px-4 py-2 no-underline transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-700 dark:hover:border-sky-400 dark:hover:text-sky-300"
      href="/en/"
    >
      Go to /en/
    </a>
  </div>
</BaseLayout>
