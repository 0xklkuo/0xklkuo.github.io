---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import TagList from '../../components/blog/TagList.astro';
import Icon from '../../components/site/Icon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  formatBlogDate,
  getBlogAlternateLinks,
  getBlogIndexPath,
  getLocaleBlogPosts,
  getLocaleSwitchPath,
  normalizeBlogPost,
  pickRelatedBlogPosts,
} from '../../lib/blog';
import { LOCALES, getAlternateLocale, type Locale } from '../../lib/i18n';
import { site } from '../../lib/site';
import { siteContent } from '../../lib/site-content';

export async function getStaticPaths() {
  const entries = await getCollection('post');

  return LOCALES.flatMap((locale) =>
    getLocaleBlogPosts(entries, locale).map((post) => ({
      params: { locale, slug: post.slug },
      props: { id: post.id, locale },
    })),
  );
}

interface Props {
  id: string;
  locale: Locale;
}

const { id, locale } = Astro.props as Props;
const entries = await getCollection('post');
const entry = entries.find((candidate) => candidate.id === id) as
  | CollectionEntry<'post'>
  | undefined;

if (!entry) {
  throw new Error(`Missing blog entry for ${id}`);
}

const post = normalizeBlogPost(entry);
const allPosts = LOCALES.flatMap((currentLocale) => getLocaleBlogPosts(entries, currentLocale));
const rawAlternateLinks = getBlogAlternateLinks(allPosts, post);
const alternateLinks = rawAlternateLinks ?? { [locale]: post.permalink };
const alternatePathname = getLocaleSwitchPath(
  locale,
  rawAlternateLinks,
  getBlogIndexPath(getAlternateLocale(locale)),
);
const relatedPosts = pickRelatedBlogPosts(allPosts, post);
const content = siteContent[locale].blog;
const { Content, remarkPluginFrontmatter } = await render(entry);
const readingTime =
  typeof remarkPluginFrontmatter?.readingTime === 'number'
    ? remarkPluginFrontmatter.readingTime
    : undefined;
const pageDescription = post.description || site.description;
---

<SiteLayout
  locale={locale}
  title={post.title}
  description={pageDescription}
  canonicalPath={post.permalink}
  author={post.author ?? site.name}
  alternatePathname={alternatePathname}
  alternateLinks={alternateLinks}
  openGraphType="article"
  socialImage={post.image?.src}
  socialImageAlt={post.title}
  keywords={post.tags}
  publishedTime={post.publishDate}
  modifiedTime={post.updatedDate}
>
  <section class="mx-auto w-full max-w-4xl">
    <article>
      <header class="border-b border-(--border-muted) pb-10">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-(--color-primary)">
          {content.eyebrow}
        </p>
        <h1 class="mt-4 font-heading text-5xl leading-tight text-(--color-heading) sm:text-6xl">
          {post.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-(--color-default)">{pageDescription}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-(--color-muted)">
          <p class="inline-flex items-center gap-2">
            <Icon name="user" class="size-4" />
            <span class="sr-only">{content.authorLabel}: </span>
            <span>{post.author ?? site.name}</span>
          </p>
          <p class="inline-flex items-center gap-2">
            <Icon name="calendar" class="size-4" />
            <span class="sr-only">{content.publishedLabel}: </span>
            <time datetime={post.publishDate.toISOString()}
              >{formatBlogDate(post.publishDate, locale)}</time
            >
          </p>
          {
            readingTime && (
              <p class="inline-flex items-center gap-2">
                <Icon name="clock" class="size-4" />
                <span>
                  {readingTime} {content.minutesRead}
                </span>
              </p>
            )
          }
          {
            post.updatedDate && (
              <p>
                <span class="font-medium text-(--color-heading)">{content.updatedLabel}:</span>
                <time datetime={post.updatedDate.toISOString()}>
                  {formatBlogDate(post.updatedDate, locale)}
                </time>
              </p>
            )
          }
        </div>

        <TagList tags={post.tags} locale={locale} className="mt-6" />
      </header>

      {
        post.image && (
          <div class="mt-10 overflow-hidden rounded-4xl border border-(--border-muted) bg-(--surface-soft) p-3">
            <Image
              src={post.image}
              alt={post.title}
              class="h-full w-full rounded-3xl object-cover"
              widths={[720, 1200]}
              sizes="(min-width: 1024px) 56rem, 100vw"
            />
          </div>
        )
      }

      <div class="content-body mt-10 text-lg">
        <Content />
      </div>
    </article>

    <div class="mt-10">
      <a
        href={post.indexPath}
        class="inline-flex items-center gap-2 rounded-full border border-(--border-muted) px-4 py-2 no-underline transition hover:border-(--color-primary) hover:text-(--color-heading)"
        data-astro-prefetch
      >
        <span aria-hidden="true">←</span>
        {content.backToIndex}
      </a>
    </div>

    <RelatedPosts
      posts={relatedPosts}
      locale={locale}
      title={content.relatedTitle}
      readLabel={content.readPost}
      publishedLabel={content.publishedLabel}
      updatedLabel={content.updatedLabel}
    />
  </section>
</SiteLayout>
