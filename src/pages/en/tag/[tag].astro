---
import { getCollection } from 'astro:content';

import PostCard from '../../../components/blog/PostCard.astro';
import TagList from '../../../components/blog/TagList.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {
  getBlogIndexPath,
  getBlogTagAlternateLinks,
  getBlogTagArchive,
  getBlogTags,
  getLocaleBlogPosts,
  getLocaleSwitchPath,
} from '../../../lib/blog';
import { siteContent } from '../../../lib/site-content';

export async function getStaticPaths() {
  const entries = await getCollection('post');
  const posts = getLocaleBlogPosts(entries, 'en');

  return getBlogTags(posts, 'en').map((tag) => ({
    params: { tag: tag.slug },
  }));
}

const locale = 'en';
const tagSlug = Astro.params.tag ?? '';
const entries = await getCollection('post');
const allPosts = getLocaleBlogPosts(entries, 'en').concat(getLocaleBlogPosts(entries, 'zh'));
const archive = getBlogTagArchive(allPosts, locale, tagSlug);

if (!archive) {
  throw new Error(`Missing blog tag archive for ${tagSlug}`);
}

const content = siteContent[locale].blog;
const rawAlternateLinks = getBlogTagAlternateLinks(allPosts, archive.slug);
const alternateLinks = rawAlternateLinks ?? { [locale]: archive.path };
const alternatePathname = getLocaleSwitchPath(locale, rawAlternateLinks, getBlogIndexPath('zh'));
const pageTitle = `${content.tagPageTitlePrefix}: #${archive.label}`;
const pageDescription = `Posts tagged #${archive.label}.`;
---

<SiteLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={archive.path}
  alternatePathname={alternatePathname}
  alternateLinks={alternateLinks}
  keywords={[archive.label, 'blog', 'tag']}
>
  <section class="mx-auto w-full max-w-5xl space-y-4">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-(--color-primary)">
      {content.tagPageEyebrow}
    </p>
    <h1 class="font-heading text-5xl leading-tight text-(--color-heading) sm:text-6xl">
      #{archive.label}
    </h1>
    <p class="max-w-3xl text-lg leading-8 text-(--color-default)">{pageDescription}</p>
    <TagList tags={[archive.label]} locale={locale} activeTagSlug={archive.slug} className="pt-2" />
  </section>

  <section class="mx-auto mt-12 grid w-full max-w-5xl gap-8 xl:grid-cols-2">
    {
      archive.posts.map((post) => (
        <PostCard
          post={post}
          locale={locale}
          readLabel={content.readPost}
          publishedLabel={content.publishedLabel}
          updatedLabel={content.updatedLabel}
        />
      ))
    }
  </section>
</SiteLayout>
