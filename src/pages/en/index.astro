---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateLocale, getLocalizedPath, homeCopy } from '../../lib/i18n';

const locale = 'en';
const content = homeCopy[locale];
const alternateLocale = getAlternateLocale(locale);
---

<BaseLayout locale={locale} title={content.homeTitle} canonicalPath={getLocalizedPath(locale)}>
  <header
    class="flex flex-col gap-4 border-b border-slate-200 pb-6 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      class="text-sm font-semibold tracking-[0.2em] text-slate-950 no-underline dark:text-slate-100"
      href={getLocalizedPath(locale)}
    >
      KL KUO
    </a>
    <div class="flex items-center gap-3 text-sm">
      <a
        class="rounded-full border border-slate-300 px-3 py-1.5 no-underline transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-700 dark:hover:border-sky-400 dark:hover:text-sky-300"
        href={getLocalizedPath(alternateLocale)}
      >
        {content.altLocaleLabel}
      </a>
      <button
        class="rounded-full border border-slate-300 px-3 py-1.5 transition hover:border-sky-500 hover:text-sky-600 dark:border-slate-700 dark:hover:border-sky-400 dark:hover:text-sky-300"
        type="button"
        data-theme-toggle
      >
        {content.themeToggleLabel}
      </button>
    </div>
  </header>

  <section class="mt-16 space-y-6">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-sky-600 dark:text-sky-300">
      {content.foundationLabel}
    </p>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
      {content.homeTitle}
    </h1>
    <p class="max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">
      {content.homeDescription}
    </p>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <article class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800">
      <h2 class="text-xl font-semibold">{content.decisionsTitle}</h2>
      <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
        {
          content.decisions.map((decision) => (
            <li class="rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-900">{decision}</li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800">
      <h2 class="text-xl font-semibold">{content.nextTitle}</h2>
      <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">
        {content.nextBody}
      </p>
      <ul class="mt-6 space-y-3 text-sm text-slate-600 dark:text-slate-300">
        <li>Astro v6</li>
        <li>Tailwind CSS v4</li>
        <li>TypeScript v5</li>
        <li>Pure static output</li>
        <li>Docs-first refactor</li>
      </ul>
    </article>
  </section>
</BaseLayout>
