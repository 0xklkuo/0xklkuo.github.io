---
import { Image } from 'astro:assets';

import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLocalizedPath } from '../../lib/i18n';
import { site } from '../../lib/site';
import { siteContent, socialLinks } from '../../lib/site-content';
import ProfileImage from '../../assets/images/profile/klkuo.guru.png';
import SocialLinks from '../../components/site/SocialLinks.astro';

const locale = 'en';
const content = siteContent[locale].home;
---

<SiteLayout
  locale={locale}
  title={site.name}
  description={site.description}
  canonicalPath={getLocalizedPath(locale)}
>
  <section class="grid gap-10 lg:grid-cols-[1.25fr_0.95fr] lg:items-center">
    <div class="space-y-6">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-(--color-primary)">
        {content.tagline}
      </p>
      <h1 class="max-w-4xl font-heading text-5xl leading-tight text-(--color-heading) sm:text-6xl">
        {content.title}
      </h1>
      <p
        class="max-w-2xl border-l-4 border-(--color-secondary) pl-4 text-lg italic leading-8 text-(--color-muted)"
      >
        {content.quote}
      </p>
      <p class="max-w-3xl text-lg leading-8 text-(--color-default)">{content.description}</p>
      <SocialLinks links={socialLinks} />
    </div>

    <div class="rounded-4xl border border-(--border-muted) bg-(--surface-soft) p-4">
      <Image
        src={ProfileImage}
        alt="KL KUO profile graphic"
        class="h-full w-full rounded-3xl object-cover"
        widths={[480, 720]}
        sizes="(min-width: 1024px) 32rem, 100vw"
      />
    </div>
  </section>

  <section class="mt-16 grid gap-6 md:grid-cols-3">
    <div class="md:col-span-3">
      <h2 class="font-heading text-3xl text-(--color-heading)">{content.featureTitle}</h2>
    </div>
    {
      content.features.map((feature) => (
        <article class="rounded-[1.75rem] border border-(--border-muted) bg-(--surface-soft) p-6">
          <h3 class="font-heading text-2xl text-(--color-heading)">{feature.title}</h3>
          <p class="mt-3 leading-7 text-(--color-default)">{feature.description}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-16 grid gap-6 lg:grid-cols-2">
    <article class="rounded-[1.75rem] border border-(--border-muted) bg-(--surface-soft) p-6">
      <h2 class="font-heading text-3xl text-(--color-heading)">{content.aboutTitle}</h2>
      <p class="mt-4 leading-8 text-(--color-default)">{content.aboutBody}</p>
      <a
        href={getLocalizedPath(locale, 'about')}
        class="mt-6 inline-flex rounded-full border border-(--color-primary) px-4 py-2 no-underline transition hover:bg-(--color-primary)/10"
      >
        {content.aboutAction}
      </a>
    </article>

    <div class="grid gap-6">
      <article class="rounded-[1.75rem] border border-(--border-muted) bg-(--surface-soft) p-6">
        <h2 class="font-heading text-3xl text-(--color-heading)">{content.writingTitle}</h2>
        <p class="mt-4 leading-8 text-(--color-default)">{content.writingBody}</p>
        <a
          href={getLocalizedPath(locale, 'blog')}
          class="mt-6 inline-flex rounded-full border border-(--color-primary) px-4 py-2 no-underline transition hover:bg-(--color-primary)/10"
        >
          {content.writingAction}
        </a>
      </article>

      <article class="rounded-[1.75rem] border border-(--border-muted) bg-(--surface-soft) p-6">
        <h2 class="font-heading text-3xl text-(--color-heading)">{content.legalTitle}</h2>
        <p class="mt-4 leading-8 text-(--color-default)">{content.legalBody}</p>
      </article>
    </div>
  </section>
</SiteLayout>
