---
const redirectTo = '/en/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://klkuo.guru/en/" />
    <title>Redirecting to /en/</title>
    <script is:inline>
      window.location.replace('/en/');
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={redirectTo}>{redirectTo}</a>.
    </p>
  </body>
</html>
