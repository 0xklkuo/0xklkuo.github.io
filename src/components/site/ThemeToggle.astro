---
import Icon from './Icon.astro';

interface Props {
  lightLabel: string;
  darkLabel: string;
}

const { lightLabel, darkLabel } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-theme-label-light={lightLabel}
  data-theme-label-dark={darkLabel}
  aria-label={lightLabel}
  title={lightLabel}
  class="inline-flex size-10 items-center justify-center rounded-full border border-(--border-muted) transition hover:border-(--color-primary) hover:text-(--color-heading)"
>
  <span class="theme-toggle-icon theme-toggle-icon--light">
    <Icon name="moon" class="size-5" />
  </span>
  <span class="theme-toggle-icon theme-toggle-icon--dark">
    <Icon name="sun" class="size-5" />
  </span>
  <span class="sr-only" data-theme-toggle-text>{lightLabel}</span>
</button>
