{
  "name": "klkuo.guru",
  "description": "Minimal static personal site for KL KUO built with Astro, Tailwind CSS, and TypeScript.",
  "version": "2026.05.19",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
