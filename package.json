    "@typescript-eslint/parser": "^8.59.4",
    "astro": "^6.3.5",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
